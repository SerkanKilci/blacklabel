{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "OpenFoodFacts": {
    "BaseUrl": "https://world.openfoodfacts.org/api/v2/product/",
    "UserAgent": "Blacklabel/1.0 (contact@blacklabel.app)"
  },
  "Usda": {
    "BaseUrl": "https://api.nal.usda.gov/fdc/v1/",
    "ApiKey": ""
  },
  "ScoreThresholds": {
    "Sugars100g": { "goodValue": 5, "badValue": 22.5 },
    "SaturatedFat100g": { "goodValue": 1, "badValue": 10 },
    "Salt100g": { "goodValue": 0.3, "badValue": 2.0 },
    "EnergyKcal100g": { "goodValue": 80, "badValue": 400 },
    "Fiber100g": { "goodValue": 4.7, "badValue": 0 },
    "Protein100g": { "goodValue": 8, "badValue": 0 }
  },
  "Jwt": {
    "Issuer": "Blacklabel",
    "Audience": "Blacklabel.Mobile",
    "ExpiryMinutes": 43200
  },
  "Auth": {
    "Apple": { "BundleId": "" },
    "Google": { "ClientId": "" }
  },
  "VisionService": {
    "Endpoint": "",
    "TimeoutSeconds": 30
  },
  "Storage": {
    "ContributionImagesPath": "App_Data/uploads/contributions"
  }
}
