    <RootNamespace>OffImporter</RootNamespace>
    <UserSecretsId>4053979e-113d-403f-897d-89ba6aa5a53a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
